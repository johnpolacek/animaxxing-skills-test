---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Work — Animaxxing" current="work">
  <article class="page shell" data-page="work" data-phase="initial" tabindex="-1">
    <h1 data-intro>Selected work</h1>
    <p data-intro>
      A reading app for a publisher who wanted the page turn to feel like paper and nothing else to
      feel like anything at all. It shipped in nine weeks and has not been redesigned since.
    </p>
    <p data-intro>
      A booking flow for a clinic, where the only animation left in the final build is the one that
      tells you a slot is gone.
    </p>
    <p data-intro>
      An archive of two hundred thousand photographs that loads the first screen before it thinks
      about the second.
    </p>
  </article>
</Layout>
