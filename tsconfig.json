{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "shared",
    "vanilla/tests",
    "nextjs/tests",
    "astro/tests",
    "sveltekit/tests",
    "nuxt/tests",
    "react-router/tests",
    "tanstack/tests",
    "vanilla/playwright.config.ts",
    "nextjs/playwright.config.ts",
    "astro/playwright.config.ts",
    "sveltekit/playwright.config.ts",
    "nuxt/playwright.config.ts",
    "react-router/playwright.config.ts",
    "tanstack/playwright.config.ts",
    "motion/tests",
    "motion/playwright.config.ts",
    "motion/global-setup.ts"
  ]
}
