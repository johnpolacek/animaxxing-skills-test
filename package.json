{
  "name": "animaxxing-skills-test",
  "private": true,
  "packageManager": "pnpm@10.6.4",
  "scripts": {
    "test": "pnpm test:vanilla && pnpm test:nextjs && pnpm test:astro && pnpm test:sveltekit && pnpm test:nuxt && pnpm test:react-router && pnpm test:tanstack",
    "test:vanilla": "playwright test -c vanilla/playwright.config.ts",
    "test:nextjs": "playwright test -c nextjs/playwright.config.ts",
    "test:astro": "playwright test -c astro/playwright.config.ts",
    "test:sveltekit": "playwright test -c sveltekit/playwright.config.ts",
    "test:nuxt": "playwright test -c nuxt/playwright.config.ts",
    "test:react-router": "playwright test -c react-router/playwright.config.ts",
    "test:tanstack": "playwright test -c tanstack/playwright.config.ts",
    "eval": "bash scripts/eval.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^24",
    "typescript": "^5.9.3"
  }
}
